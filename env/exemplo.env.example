# Copie para env/<usuario>.env (só letras e números, começando por letra minúscula).
# Cada arquivo vira um flavor e um APK próprio.
NOME_USUARIO=Nome da pessoa
ID_USUARIO=000
# Casas que este APK mostra, separadas por vírgula: esp (Casa do Fernando), clp (Casa do Felipe)
CASAS=esp,clp
# Broker MQTT (lotus-bkd/broker/README.md). Só o release usa; o debug roda no simulador.
# ssl://<endereço do EMQX>:8883, ou tcp://10.0.2.2:1883 para o Mosquitto local visto do emulador.
MQTT_URL=ssl://xxxxxxxx.ala.us-east-1.emqxsl.com:8883
# app-esp, app-clp ou app-admin, de acordo com as CASAS acima
MQTT_USUARIO=app-admin
MQTT_SENHA=
